# production environment of the microvpn container (copied to ~/microvpn/.env by setup.sh)
DATABASE=/data/microvpn.db
ROOT_PATH=/microvpn
PUBLIC_URL=https://raubcamaioni.com/microvpn
RELAY_HOST=raubcamaioni.com
HTTP_BIND=0.0.0.0:8080
RELAY_BIND=0.0.0.0
RELAY_PORT_RANGE=20000-21999
ROOM_MBPS=50
RELAY_TOTAL_MBPS=200
ROOM_MAX_MEMBERS=8
ROOM_MAX_LIVE=64
ROOM_CREATE_PER_IP_PER_HOUR=3
ROOM_LIFETIMES=1,4,12,24
FORWARDED_ALLOW_IPS=172.18.0.0/16
