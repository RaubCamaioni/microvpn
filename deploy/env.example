# production environment of the microvpn container (copied to ~/microvpn/.env by setup.sh)
DATABASE=/data/microvpn.db
ROOT_PATH=/microvpn
PUBLIC_URL=https://raubcamaioni.com/microvpn
RELAY_HOST=raubcamaioni.com
HTTP_BIND=0.0.0.0:8080
RELAY_BIND=0.0.0.0
RELAY_PORT_RANGE=20000-21999
ROOM_MBPS=50
RELAY_TOTAL_MBPS=200
ROOM_MAX_MEMBERS=8
ROOM_MAX_LIVE=64
ROOM_CREATE_PER_IP_PER_HOUR=3
ROOM_JOIN_PER_IP_PER_HOUR=60
ROOM_LIFETIMES=1,4,12,24
FORWARDED_ALLOW_IPS=172.18.0.0/16
# Signing in with GitHub (README, "Accounts and permanent rooms"). Leave the two GITHUB_ values
# empty for no login. They are secrets: fill them in on the server only, never in the repository.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# numeric GitHub ids (not logins) of the accounts that may make rooms with no expiry
ADMIN_GITHUB_IDS=
PERMANENT_ROOMS_PER_ACCOUNT=3
